# Safe placeholders only. Replace them with real values from your providers before deployment.
# Never commit a real .env.local file or put server secrets in VITE_* variables.

# Required for the full server-backed storefront and Manus OAuth.
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME
MANUS_PROJECT_ID=REPLACE_WITH_MANUS_PROJECT_ID
MANUS_JWT_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET_32_CHARS_OR_MORE
MANUS_OAUTH_API_URL=https://api.manus.ai
MANUS_OAUTH_PORTAL_URL=REPLACE_WITH_MANUS_OAUTH_PORTAL_BASE_URL

# Needed only by Manus API-backed features (for example LLM, storage, maps or image services).
MANUS_API_URL=REPLACE_WITH_MANUS_API_BASE_URL
MANUS_API_KEY=REPLACE_WITH_SERVER_SIDE_MANUS_API_KEY
# Maps only; this key is intentionally exposed to the browser and must be browser-restricted.
MANUS_API_BROWSER_KEY=REPLACE_WITH_BROWSER_RESTRICTED_KEY

# Optional: grant admin role to this account's verified Manus OAuth email.
NUIT_ADMIN_EMAIL=admin@example.com
# Alternative legacy admin grant, normally leave unset when using NUIT_ADMIN_EMAIL.
# OWNER_OPEN_ID=REPLACE_WITH_MANUS_OPEN_ID

# Optional LiqPay sandbox checkout; use real official sandbox_ keys only.
LIQPAY_PUBLIC_KEY=sandbox_REPLACE_WITH_TEST_PUBLIC_KEY
LIQPAY_PRIVATE_KEY=sandbox_REPLACE_WITH_TEST_PRIVATE_KEY
# Set to your deployed origin when enabling payment callbacks on Vercel.
NUIT_PUBLIC_URL=https://your-project.vercel.app

# Vercel sets NODE_ENV for the deployment. PORT applies to a self-hosted server, not Functions.

# Supabase project settings (Project Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# The server-side product catalog reader can use these names too; use the same URL and anon key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
